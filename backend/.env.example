APP_NAME=Community Attendance API
ENVIRONMENT=development

# Database connection. Either set DATABASE_URL directly, or keep the DB_* values
# in sync with docker-compose.yml.
DB_NAME=attendance
DB_USER=attendance
DB_PASSWORD=attendance
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://attendance:attendance@db:5432/attendance

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=*
PUBLIC_QR_RATE_LIMIT_PER_MINUTE=60

FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
FIRST_ADMIN_FULL_NAME=Administrador
